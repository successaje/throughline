# Qloo Insights API key. Hackathon keys only work on the hackathon host.
# Without a key, Throughline runs on fictional sample places.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Claude powers the planning agent and progress notes.
# Without a key, a rules planner uses the same Qloo searches and ranking.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Gemini runs the same agent when no Claude key is set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
